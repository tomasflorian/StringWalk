# a taxonomy is a reader's vocabulary, and the shell's own. it decides which
# names you are shown and nothing about what a reading is.
taxonomy triage
# the tree, counted from the pile.
taxonomy
# only the taxonomy's top names are listed; every other kind is counted, not shown.
add
add --all
# a name is written out as the kinds it stands for before the session sees it.
# more than one way in needs the *, the same as a kind does.
add network
add network*
add
# the query is the group spelled out, and the shorter form for read.ts.
query
# another vocabulary over the same reading: the reading does not move.
taxonomy netops
add
taxonomy off
add
